/* IMX678 Camera on CSI0 */

/ {
    cam0_clk: cam0_clk {
	    compatible = "fixed-clock";
	    #clock-cells = <0>;
		status = "okay";
		clock-frequency = <24000000>;
    };

    cam0_reg: cam0_reg {
	    compatible = "regulator-fixed";
	    regulator-name = "cam0_reg";
	    enable-active-high;
	    status = "okay";
	    startup-delay-us = <200000>;
	    off-on-delay-us = <30000>;
	    gpio = <&rp1_gpio 46 0>;  // CD1_IO0_MICCLK, to MIPI 1 connector
    };

    cam0_dummy_reg: cam0_dummy_reg {
	    compatible = "regulator-fixed";
	    regulator-name = "cam-dummy-reg";
	    status = "okay";
    };
};

&rp1_i2c6 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	imx678@1a {
		compatible = "sony,imx678";
		reg = <0x1a>;
	    	status = "okay";

		clocks = <&cam0_clk>;

		avdd-supply = <&cam0_reg>;	/* 3.3v */
		dvdd-supply = <&cam0_dummy_reg>;	/* 1.1v */
		ovdd-supply = <&cam0_dummy_reg>;	/* 1.8v */

		rotation = <0>;
		orientation = <2>;

		port {
			cam0_endpoint: endpoint {
				remote-endpoint = <&csi0_ep>;
				clock-lanes = <0>;
				data-lanes = <1 2 3 4>;
				clock-noncontinuous;
				link-frequencies = /bits/ 64 <720000000>;
			};
		};
	};
};

&rp1_csi0 {
	status = "okay";

	port {
		csi0_ep: endpoint {
			remote-endpoint = <&cam0_endpoint>;
			clock-lanes = <0>;
			data-lanes = <1 2 3 4>;
			clock-noncontinuous;
		};
	};
};
